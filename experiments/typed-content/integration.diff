+          throw Error(reply.message || "Unexpected content response");
+        result = {
+          data: reply.snapshot.data,
+          version: reply.snapshot.revision,
+          error: reply.snapshot.warning,
+        };
+      } else
+        result = await api.call("portal-frame", {
+          ...message.input,
+          id: view.id,
+          action: message.op,
