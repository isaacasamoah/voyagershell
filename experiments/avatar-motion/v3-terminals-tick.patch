 struct Changed;
 
+thread_local! {
+    static DRAG_MOVED_AT: Cell<Option<Instant>> = const { Cell::new(None) };
+    static DRAG_EPOCH: Instant = Instant::now();
+}
+
+const DRAG_QUIET: std::time::Duration = std::time::Duration::from_millis(120);
+
+const DRAG_TERMINAL_TICK: std::time::Duration = std::time::Duration::from_millis(100);
+
+pub(crate) fn dragging() -> bool {
+    DRAG_MOVED_AT.with(|moved| moved.get().is_some_and(|at| at.elapsed() < DRAG_QUIET))
+}
+
+pub(crate) fn drag_tick() -> Option<u128> {
+    dragging().then(|| {
+        DRAG_EPOCH.with(|epoch| epoch.elapsed().as_millis() / DRAG_TERMINAL_TICK.as_millis())
+    })
+}
+
