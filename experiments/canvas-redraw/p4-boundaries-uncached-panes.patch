diff --git a/desktop/src/cached.rs b/desktop/src/cached.rs
new file mode 100644
index 00000000..0c046b45
--- /dev/null
+++ b/desktop/src/cached.rs
@@ -0,0 +1,99 @@
+use std::{cell::RefCell, collections::HashMap, sync::Arc};
+
+use gpui::{
+    App, AppContext as _, Context, Entity, IntoElement, ParentElement as _, Render,
+    StyleRefinement, Styled as _, Window, div,
+};
+use gpui_shell::{
+    ArgumentDescriptor, ArgumentSchema, ComponentArgument, ComponentDescriptor,
+    ComponentElementFactory, ComponentMaterializer, ComponentPayload, ComponentRegistry,
+    ConstructorDescriptor, MaterializeRequest, RegistryError,
+};
+
+struct Boundary {
+    factory: Option<ComponentElementFactory>,
+}
+
+impl Render for Boundary {
+    fn render(&mut self, window: &mut Window, cx: &mut Context<Self>) -> impl IntoElement {
+        crate::diagnostics::redraw::record("boundary_renders", 1);
+        let root = div().size_full().flex().flex_col();
+        match self.factory.as_ref().map(|factory| factory.build(window, cx)) {
+            Some(Ok(element)) => root.child(element),
+            Some(Err(error)) => root.child(format!("{error:#}")),
+            None => root,
+        }
+    }
+}
+
+thread_local! {
+    static BOUNDARIES: RefCell<HashMap<String, Entity<Boundary>>> = RefCell::new(HashMap::new());
+}
+
+pub(crate) fn invalidate(cx: &mut App) {
+    let boundaries: Vec<_> = BOUNDARIES.with_borrow(|held| held.values().cloned().collect());
+    for boundary in boundaries {
+        boundary.update(cx, |_, cx| cx.notify());
+    }
+}
+
+struct Cached;
+
+impl ComponentMaterializer for Cached {
+    fn materialize(&self, mut request: MaterializeRequest<'_>) -> anyhow::Result<gpui::AnyElement> {
+        let key = request
+            .payload()
+            .downcast_ref::<String>()
+            .cloned()
+            .ok_or_else(|| anyhow::anyhow!("Cached requires a key"))?;
+        let factory = request.take_slot_factory("content");
+        let boundary = request.with_window_app(|_, cx| {
+            let held = BOUNDARIES.with_borrow(|held| held.get(&key).cloned());
+            Ok(match held {
+                Some(boundary) => {
+                    boundary.update(cx, |boundary, _| boundary.factory = factory);
+                    boundary
+                }
+                None => {
+                    let boundary = cx.new(|_| Boundary { factory });
+                    BOUNDARIES.with_borrow_mut(|held| held.insert(key.clone(), boundary.clone()));
+                    boundary
+                }
+            })
+        })?;
+        request.finish(div().child(boundary.cached(StyleRefinement::default().size_full())))
+    }
+}
+
+pub fn register(registry: &mut ComponentRegistry) -> Result<(), RegistryError> {
+    registry.register(
+        ComponentDescriptor::new("Cached", Arc::new(Cached)).with_constructors(vec![
+            ConstructorDescriptor::new(
+                "Cached",
+                vec![ArgumentDescriptor::new("key", ArgumentSchema::String)],
+                |arguments| match arguments {
+                    [ComponentArgument::String(key)] => Ok(ComponentPayload::new(key.clone())),
+                    _ => Err("Cached(key) expects a string".into()),
+                },
+            ),
+        ]),
+    )?;
+    Ok(())
+}
+
+pub(crate) fn observe(
+    root: &Entity<gpui_shell::ShellRoot>,
+    cx: &mut App,
+) -> Option<gpui::Subscription> {
+    let script = root
+        .read(cx)
+        .content()
+        .clone()
+        .downcast::<gpui_shell::ScriptView>()
+        .ok()?;
+    Some(cx.observe(&script, |script, cx| {
+        if script.read(cx).is_dirty() {
+            invalidate(cx);
+        }
+    }))
+}
