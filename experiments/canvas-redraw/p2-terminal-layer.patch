diff --git a/desktop/src/terminal_layer.rs b/desktop/src/terminal_layer.rs
new file mode 100644
index 00000000..e7d97fdc
--- /dev/null
+++ b/desktop/src/terminal_layer.rs
@@ -0,0 +1,111 @@
+use std::{cell::RefCell, panic::Location};
+
+use gpui::{
+    AnyElement, App, Bounds, ContentMask, Element, ElementId, Entity, GlobalElementId,
+    InspectorElementId, IntoElement, LayoutId, Pixels, Position, Style, StyleRefinement, Window,
+    Styled as _, relative,
+};
+
+#[derive(Default)]
+struct Placed {
+    shown: Vec<(Entity<crate::terminal::Pane>, Bounds<Pixels>, ContentMask<Pixels>)>,
+    fresh: Vec<(Entity<crate::terminal::Pane>, Bounds<Pixels>, ContentMask<Pixels>)>,
+    reset: bool,
+}
+
+thread_local! {
+    static PLACED: RefCell<Placed> = RefCell::new(Placed::default());
+}
+
+pub(crate) fn reset() {
+    PLACED.with_borrow_mut(|placed| placed.reset = true);
+}
+
+pub(crate) fn place(pane: Entity<crate::terminal::Pane>, bounds: Bounds<Pixels>, mask: ContentMask<Pixels>) {
+    PLACED.with_borrow_mut(|placed| placed.fresh.push((pane, bounds, mask)));
+}
+
+pub(crate) struct Layer;
+
+impl IntoElement for Layer {
+    type Element = Self;
+
+    fn into_element(self) -> Self {
+        self
+    }
+}
+
+impl Element for Layer {
+    type RequestLayoutState = ();
+    type PrepaintState = Vec<(AnyElement, ContentMask<Pixels>)>;
+
+    fn id(&self) -> Option<ElementId> {
+        Some("terminal-layer".into())
+    }
+
+    fn source_location(&self) -> Option<&'static Location<'static>> {
+        None
+    }
+
+    fn request_layout(
+        &mut self,
+        _: Option<&GlobalElementId>,
+        _: Option<&InspectorElementId>,
+        window: &mut Window,
+        cx: &mut App,
+    ) -> (LayoutId, ()) {
+        let mut style = Style {
+            position: Position::Absolute,
+            ..Style::default()
+        };
+        style.size.width = relative(1.).into();
+        style.size.height = relative(1.).into();
+        (window.request_layout(style, [], cx), ())
+    }
+
+    fn prepaint(
+        &mut self,
+        _: Option<&GlobalElementId>,
+        _: Option<&InspectorElementId>,
+        _: Bounds<Pixels>,
+        _: &mut (),
+        window: &mut Window,
+        cx: &mut App,
+    ) -> Self::PrepaintState {
+        let shown = PLACED.with_borrow_mut(|placed| {
+            if placed.reset || !placed.fresh.is_empty() {
+                placed.shown = std::mem::take(&mut placed.fresh);
+                placed.reset = false;
+            }
+            placed.shown.clone()
+        });
+        shown
+            .into_iter()
+            .map(|(pane, bounds, mask)| {
+                let mut element = pane
+                    .cached(StyleRefinement::default().size_full())
+                    .into_any_element();
+                window.with_content_mask(Some(mask), |window| {
+                    element.layout_as_root(bounds.size.into(), window, cx);
+                    element.prepaint_at(bounds.origin, window, cx);
+                });
+                (element, mask)
+            })
+            .collect()
+    }
+
+    fn paint(
+        &mut self,
+        _: Option<&GlobalElementId>,
+        _: Option<&InspectorElementId>,
+        _: Bounds<Pixels>,
+        _: &mut (),
+        elements: &mut Self::PrepaintState,
+        window: &mut Window,
+        cx: &mut App,
+    ) {
+        for (element, mask) in elements {
+            window.with_content_mask(Some(*mask), |window| element.paint(window, cx));
+        }
+    }
+}
