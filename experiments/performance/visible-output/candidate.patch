+    pub(super) fn visible_change(&mut self, drawn: Option<&Grid>) -> Result<bool> {
+        let Some(drawn) = drawn else { return Ok(true) };
+        let snapshot = self.render.update(&self.terminal)?;
+        let cursor = snapshot.cursor()?;
+        let visible = |cursor: Option<libghostty_vt::render::Cursor>| {
+            cursor
+                .filter(|cursor| cursor.visible)
+                .and_then(|cursor| cursor.viewport.map(|point| (point, cursor.visual_style)))
+        };
+        Ok(snapshot.dirty()? != libghostty_vt::render::Dirty::Clean
+            || visible(cursor.visible.then_some(cursor)) != visible(drawn.cursor)
+            || snapshot.colors()? != drawn.colors)
+    }
