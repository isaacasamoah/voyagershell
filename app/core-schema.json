{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CoreMessages",
  "type": "object",
  "definitions": {
    "HelloParams": {
      "type": "object",
      "properties": {
        "calls_you": {
          "description": "What that core calls this one (`rohan`), so news about `t7` reaches it as `rohan/t7`.",
          "type": [
            "string",
            "null"
          ]
        },
        "core": {
          "anyOf": [
            {
              "$ref": "#/definitions/CoreInfo"
            },
            {
              "type": "null"
            }
          ],
          "description": "Another core dialing in: who it is. Its terminals may then be parents\nof terminals here, and hear from them."
        },
        "framed": {
          "default": false,
          "description": "Switch this connection to framed mode after the reply.",
          "type": "boolean"
        },
        "generation": {
          "description": "Protocol generation the caller speaks.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": []
    },
    "DocGetParams": {
      "type": "object",
      "properties": {
        "name": {
          "description": "Document name, using the terminal name rules.",
          "type": "string"
        },
        "on": {
          "description": "Another machine; omitted for this core.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name"
      ]
    },
    "DocSetParams": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "on": {
          "type": [
            "string",
            "null"
          ]
        },
        "value": {
          "description": "Any JSON value, at most 1 MiB when serialized; null deletes it."
        },
        "version": {
          "description": "Current version from doc.get; zero for a name never written.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "name",
        "value",
        "version"
      ]
    },
    "GetParams": {
      "type": "object",
      "properties": {
        "caller": {
          "description": "Who is calling; a parent looking at its child has seen its news.",
          "type": [
            "string",
            "null"
          ]
        },
        "terminal": {
          "description": "The terminal: `t7`, a name, or `machine/t7`.",
          "type": "string"
        }
      },
      "required": [
        "terminal"
      ]
    },
    "StopParams": {
      "type": "object",
      "properties": {},
      "required": []
    },
    "StatusParams": {
      "type": "object",
      "properties": {},
      "required": []
    },
    "RunParams": {
      "type": "object",
      "properties": {
        "argv": {
          "default": [],
          "description": "Program and arguments, or a template name and its task. With neither\nargv nor line: that machine's own shell.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "caller": {
          "description": "Who is calling (`HC_TERMINAL_ID` inside a terminal).",
          "type": [
            "string",
            "null"
          ]
        },
        "cwd": {
          "description": "Working directory (default: where hc runs; through the API, the core's;\nwith --on, that machine's home).",
          "type": [
            "string",
            "null"
          ]
        },
        "die_with_parent": {
          "default": false,
          "description": "Ignored: children end with their parent unless `outlive_parent`.",
          "type": "boolean"
        },
        "env": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "description": "Set on top of the core's environment. Clients pass their terminal\nidentity here (TERM, TERM_PROGRAM, COLORTERM).",
          "type": "object"
        },
        "keep": {
          "default": false,
          "description": "Replace lost programs with a shell in place, never re-run the original command.",
          "type": "boolean"
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "description": "Labels, key=value (repeatable).",
          "type": "object"
        },
        "line": {
          "description": "A shell line instead of argv, run by that machine's shell (`sh -c`;\nWindows `%COMSPEC% /d /s /c`). The CLI sends one string with spaces or\nshell signs as a line.",
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "description": "Name, unique among live terminals: 1-32 of a-z 0-9 - _ .",
          "type": [
            "string",
            "null"
          ]
        },
        "no_notify": {
          "default": false,
          "description": "Don't type notes about it into its parent.",
          "type": "boolean"
        },
        "no_parent": {
          "default": false,
          "description": "No parent, even when started from a terminal.",
          "type": "boolean"
        },
        "on": {
          "description": "Run it on another machine (see `hc machine ls`); its address is `machine/t7`.",
          "type": [
            "string",
            "null"
          ]
        },
        "outlive_parent": {
          "default": false,
          "description": "Keep it running when its parent's program ends (by default it ends too).",
          "type": "boolean"
        },
        "parent": {
          "description": "Parent terminal (default: the terminal it is started from).",
          "type": [
            "string",
            "null"
          ]
        },
        "rm": {
          "default": false,
          "description": "Remove it right after it exits (once a waiting parent has the exit code).",
          "type": "boolean"
        },
        "timeout": {
          "description": "Seconds before a wait checks in, leaving it running (default: config\n`wait_timeout`, else 180).",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "wait": {
          "default": false,
          "description": "Then wait until it is not working, like `terminal.wait`, and return its\noutput (the CLI waits unless --bg).",
          "type": "boolean"
        }
      },
      "required": []
    },
    "AttachParams": {
      "type": "object",
      "properties": {
        "caller": {
          "default": null,
          "description": "Who is calling (`HC_TERMINAL_ID` inside a terminal): never itself.",
          "type": [
            "string",
            "null"
          ]
        },
        "cols": {
          "description": "The viewer's size in cells.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "display": {
          "$ref": "#/definitions/Display",
          "default": {
            "bg": null,
            "cell": null,
            "cursor": null,
            "fg": null
          },
          "description": "The viewer's own colors and cell size, used to answer display queries."
        },
        "history": {
          "default": 0,
          "description": "Scrollback lines to show first (main screen only).",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "observe": {
          "default": false,
          "description": "Watch only: never type or resize.",
          "type": "boolean"
        },
        "resumed": {
          "default": false,
          "description": "Back after a dropped line: sets the size only once active again.",
          "type": "boolean"
        },
        "rows": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "terminal": {
          "description": "The terminal: `t7`, a name, or `machine/t7`.",
          "type": "string"
        }
      },
      "required": [
        "cols",
        "rows",
        "terminal"
      ]
    },
    "ListParams": {
      "type": "object",
      "properties": {
        "all": {
          "default": false,
          "description": "Include finished terminals.",
          "type": "boolean"
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "description": "Only terminals carrying all of these labels (repeatable).",
          "type": "object"
        }
      },
      "required": []
    },
    "ReadParams": {
      "type": "object",
      "properties": {
        "caller": {
          "type": [
            "string",
            "null"
          ]
        },
        "lines": {
          "default": 0,
          "description": "Lines of history above the screen.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "terminal": {
          "description": "The terminal: `t7`, a name, or `machine/t7`.",
          "type": "string"
        }
      },
      "required": [
        "terminal"
      ]
    },
    "SendParams": {
      "type": "object",
      "properties": {
        "caller": {
          "description": "Who is sending (`HC_TERMINAL_ID`, else the calling process's parent), so a\nbare wait from the same caller waits for this send's turn.",
          "type": [
            "string",
            "null"
          ]
        },
        "force": {
          "default": false,
          "description": "Type even if the program is blocked (it may answer its dialog).",
          "type": "boolean"
        },
        "if": {
          "anyOf": [
            {
              "$ref": "#/definitions/IdleOrWorking"
            },
            {
              "type": "null"
            }
          ],
          "description": "Only type if the status is exactly this."
        },
        "terminal": {
          "description": "The terminal: `t7`, a name, or `machine/t7`.",
          "type": "string"
        },
        "text": {
          "description": "Pasted, then submitted with Enter.",
          "type": "string"
        },
        "timeout": {
          "description": "With wait: seconds before it checks in (default: config, else 180).",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "wait": {
          "default": false,
          "description": "Then wait for the turn this send started.",
          "type": "boolean"
        }
      },
      "required": [
        "terminal",
        "text"
      ]
    },
    "InterruptParams": {
      "type": "object",
      "properties": {
        "terminal": {
          "description": "The terminal: `t7`, a name, or `machine/t7`.",
          "type": "string"
        },
        "timeout": {
          "description": "Seconds to watch for an effect (default 10).",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "terminal"
      ]
    },
    "KillParams": {
      "type": "object",
      "properties": {
        "caller": {
          "description": "Who is calling; a parent looking at its child has seen its news.",
          "type": [
            "string",
            "null"
          ]
        },
        "terminal": {
          "description": "The terminal: `t7`, a name, or `machine/t7`.",
          "type": "string"
        }
      },
      "required": [
        "terminal"
      ]
    },
    "CoreInfo": {
      "properties": {
        "id": {
          "description": "Permanent random id, reset only when state is wiped.",
          "type": "string"
        },
        "name": {
          "description": "Display name, the hostname by default.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "type": "object"
    },
    "HelloResult": {
      "properties": {
        "core": {
          "$ref": "#/definitions/CoreInfo"
        },
        "features": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "framed": {
          "type": "boolean"
        },
        "generation": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "methods": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "generation",
        "version",
        "core",
        "framed",
        "methods",
        "features"
      ],
      "type": "object"
    },
    "DocGetResult": {
      "properties": {
        "value": true,
        "version": {
          "description": "Zero when never written. Deletions retain their version.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "value",
        "version"
      ],
      "type": "object"
    },
    "DocSetResult": {
      "properties": {
        "version": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "version"
      ],
      "type": "object"
    },
    "Terminal": {
      "properties": {
        "address": {
          "description": "`t7`: this terminal forever on this core.",
          "type": "string"
        },
        "argv": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "cols": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "created_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "cwd": {
          "type": "string"
        },
        "die_with_parent": {
          "default": false,
          "type": "boolean"
        },
        "exit_code": {
          "format": "int32",
          "type": [
            "integer",
            "null"
          ]
        },
        "finished_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "foreground": {
          "anyOf": [
            {
              "$ref": "#/definitions/Foreground"
            },
            {
              "type": "null"
            }
          ],
          "description": "What runs in it right now and where (null once it has finished)."
        },
        "identity": {
          "default": "",
          "description": "Which terminal the program believes it runs in (TERM_PROGRAM and\nversion), fixed at start; XTVERSION answers with it.",
          "type": "string"
        },
        "keep": {
          "default": false,
          "description": "Replace a lost program with this machine’s shell, in place. Exit with a code and kill remain final.",
          "type": "boolean"
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "notify": {
          "default": false,
          "description": "Its parent gets notes about it (see `--no-notify`).",
          "type": "boolean"
        },
        "parent": {
          "default": null,
          "description": "The terminal that started it (`t3`), set once at start.",
          "type": [
            "string",
            "null"
          ]
        },
        "paste_gap_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "pid": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "reason": {
          "description": "Why its program ended or is pending (`spawn_pending` means its initial\nspawn timed out, but the holder may still be starting it):\nexited, killed, server_stop, host_shutdown (Windows\nis ending the session, including logout), signaled (a kept program\ndied by signal without an exit code), holder_lost (its holder\ndied), stopped_by_restart (nothing ran it any more after a restart).",
          "type": [
            "string",
            "null"
          ]
        },
        "records": {
          "additionalProperties": {
            "$ref": "#/definitions/Status"
          },
          "description": "Other 7501 records by id (programs reporting on several things).",
          "type": "object"
        },
        "reported": {
          "default": false,
          "description": "Whether the program ever sent a 7501 report.",
          "type": "boolean"
        },
        "rm": {
          "default": false,
          "description": "Removed right after it exits (once a waiting parent has the exit code).",
          "type": "boolean"
        },
        "rows": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "screen": {
          "description": "\"exact\", or \"inexact\" after a core crash (older history may be missing).",
          "type": "string"
        },
        "signal": {
          "format": "int32",
          "type": [
            "integer",
            "null"
          ]
        },
        "state": {
          "description": "\"live\" or \"finished\".",
          "type": "string"
        },
        "status": {
          "anyOf": [
            {
              "$ref": "#/definitions/Status"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The program's own word for what it's doing (OSC 7501 root record);\nnull if it never said, or after it exited."
        },
        "status_ms": {
          "default": null,
          "description": "When that word last changed, ms since the epoch; null if it never said.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "stop": {
          "type": [
            "string",
            "null"
          ]
        },
        "submit": {
          "description": "Template overrides: the key that submits a message, the stop key, the pause\nbetween paste and submit.",
          "type": [
            "string",
            "null"
          ]
        },
        "template": {
          "default": null,
          "description": "The template that started it.",
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "default": "",
          "type": "string"
        },
        "turn": {
          "default": 0,
          "description": "Goes up each time the status leaves `working`.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "address",
        "labels",
        "argv",
        "cwd",
        "state",
        "created_ms",
        "screen",
        "cols",
        "rows"
      ],
      "type": "object"
    },
    "StopResult": {
      "properties": {
        "stopped": {
          "type": "boolean"
        }
      },
      "required": [
        "stopped"
      ],
      "type": "object"
    },
    "StatusResult": {
      "properties": {
        "core": {
          "$ref": "#/definitions/CoreInfo"
        },
        "finished": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "holder": {
          "anyOf": [
            {
              "$ref": "#/definitions/HolderInfo"
            },
            {
              "type": "null"
            }
          ],
          "description": "The holder new terminals go to."
        },
        "holders": {
          "description": "Every holder: after an update, older ones run their terminals to the end.",
          "items": {
            "$ref": "#/definitions/HolderInfo"
          },
          "type": "array"
        },
        "installed_by": {
          "description": "The package manager this hc came from (homebrew, nix, mise, or\nsystem package manager): it updates hc, `hc update` won't.\nNull for a replaceable plain install.",
          "type": [
            "string",
            "null"
          ]
        },
        "live": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "pid": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "uptime_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "core",
        "version",
        "pid",
        "uptime_ms",
        "holders",
        "live",
        "finished"
      ],
      "type": "object"
    },
    "RunResult": {
      "properties": {
        "address": {
          "description": "`t7`: this terminal forever on this core.",
          "type": "string"
        },
        "argv": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "cols": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "created_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "cwd": {
          "type": "string"
        },
        "die_with_parent": {
          "default": false,
          "type": "boolean"
        },
        "exit_code": {
          "format": "int32",
          "type": [
            "integer",
            "null"
          ]
        },
        "finished_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "first_message": {
          "anyOf": [
            {
              "$ref": "#/definitions/FirstMessage"
            },
            {
              "type": "null"
            }
          ],
          "description": "Template runs: whether the first message went in."
        },
        "foreground": {
          "anyOf": [
            {
              "$ref": "#/definitions/Foreground"
            },
            {
              "type": "null"
            }
          ],
          "description": "What runs in it right now and where (null once it has finished)."
        },
        "identity": {
          "default": "",
          "description": "Which terminal the program believes it runs in (TERM_PROGRAM and\nversion), fixed at start; XTVERSION answers with it.",
          "type": "string"
        },
        "keep": {
          "default": false,
          "description": "Replace a lost program with this machine’s shell, in place. Exit with a code and kill remain final.",
          "type": "boolean"
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "notify": {
          "default": false,
          "description": "Its parent gets notes about it (see `--no-notify`).",
          "type": "boolean"
        },
        "output": {
          "description": "With `wait`: its text then, like `terminal.read` (the screen, plus\nhistory unless it is a full-screen app).",
          "type": [
            "string",
            "null"
          ]
        },
        "parent": {
          "default": null,
          "description": "The terminal that started it (`t3`), set once at start.",
          "type": [
            "string",
            "null"
          ]
        },
        "paste_gap_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "pid": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "reason": {
          "description": "Why its program ended or is pending (`spawn_pending` means its initial\nspawn timed out, but the holder may still be starting it):\nexited, killed, server_stop, host_shutdown (Windows\nis ending the session, including logout), signaled (a kept program\ndied by signal without an exit code), holder_lost (its holder\ndied), stopped_by_restart (nothing ran it any more after a restart).",
          "type": [
            "string",
            "null"
          ]
        },
        "records": {
          "additionalProperties": {
            "$ref": "#/definitions/Status"
          },
          "description": "Other 7501 records by id (programs reporting on several things).",
          "type": "object"
        },
        "reported": {
          "default": false,
          "description": "Whether the program ever sent a 7501 report.",
          "type": "boolean"
        },
        "rm": {
          "default": false,
          "description": "Removed right after it exits (once a waiting parent has the exit code).",
          "type": "boolean"
        },
        "rows": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "screen": {
          "description": "\"exact\", or \"inexact\" after a core crash (older history may be missing).",
          "type": "string"
        },
        "signal": {
          "format": "int32",
          "type": [
            "integer",
            "null"
          ]
        },
        "state": {
          "description": "\"live\" or \"finished\".",
          "type": "string"
        },
        "status": {
          "anyOf": [
            {
              "$ref": "#/definitions/Status"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The program's own word for what it's doing (OSC 7501 root record);\nnull if it never said, or after it exited."
        },
        "status_ms": {
          "default": null,
          "description": "When that word last changed, ms since the epoch; null if it never said.",
