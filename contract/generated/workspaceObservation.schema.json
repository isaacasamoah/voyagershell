{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "Branch": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "named",
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "name"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "detached",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "unavailable",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "Corner": {
      "enum": [
        "top-left",
        "top-right",
        "bottom-left",
        "bottom-right"
      ],
      "type": "string"
    },
    "Directory": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "live",
              "type": "string"
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "path"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "voyage",
              "type": "string"
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "path"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "starting",
              "type": "string"
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "path"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "unavailable",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "PanelObservation": {
      "additionalProperties": false,
      "properties": {
        "address": {
          "type": "string"
        },
        "backend": {
          "type": [
            "string",
            "null"
          ]
        },
        "contentId": {
          "type": "string"
        },
        "conversationName": {
          "type": [
            "string",
            "null"
          ]
        },
        "directory": {
          "$ref": "#/definitions/Directory"
        },
        "effectiveName": {
          "type": "string"
        },
        "placementId": {
          "type": "string"
        },
        "position": {
          "anyOf": [
            {
              "$ref": "#/definitions/Position"
            },
            {
              "type": "null"
            }
          ]
        },
        "program": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "placementId",
        "contentId",
        "directory",
        "effectiveName",
        "address"
      ],
      "type": "object"
    },
    "Position": {
      "additionalProperties": false,
      "properties": {
        "column": {
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "columnSpan": {
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "columns": {
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "corners": {
          "items": {
            "$ref": "#/definitions/Corner"
          },
          "type": "array"
        },
        "row": {
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "rowSpan": {
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "rows": {
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "column",
        "row",
        "columnSpan",
        "rowSpan",
        "columns",
        "rows",
        "corners"
      ],
      "type": "object"
    }
  },
  "properties": {
    "active": {
      "type": [
        "string",
        "null"
      ]
    },
    "branch": {
      "$ref": "#/definitions/Branch"
    },
    "directory": {
      "$ref": "#/definitions/Directory"
    },
    "panels": {
      "items": {
        "$ref": "#/definitions/PanelObservation"
      },
      "type": "array"
    },
    "version": {
      "type": "string"
    }
  },
  "required": [
    "version",
    "directory",
    "panels",
    "branch"
  ],
  "title": "WorkspaceObservation",
  "type": "object"
}
