{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "Context": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "workspace",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "const": "voyage",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "const": "fleet",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "const": "vessel",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "const": "portal",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        }
      ]
    },
    "Message": {
      "additionalProperties": false,
      "properties": {
        "context": {
          "anyOf": [
            {
              "$ref": "#/definitions/Context"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "type": "string"
        },
        "requestId": {
          "type": "string"
        },
        "role": {
          "$ref": "#/definitions/Role"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "requestId",
        "role",
        "text"
      ],
      "type": "object"
    },
    "Phase": {
      "enum": [
        "idle",
        "starting",
        "working",
        "completed",
        "interrupted",
        "failed",
        "unconfirmed"
      ],
      "type": "string"
    },
    "Role": {
      "enum": [
        "user",
        "assistant"
      ],
      "type": "string"
    }
  },
  "properties": {
    "error": {
      "type": [
        "string",
        "null"
      ]
    },
    "limited": {
      "type": "boolean"
    },
    "messages": {
      "items": {
        "$ref": "#/definitions/Message"
      },
      "type": "array"
    },
    "model": {
      "type": [
        "string",
        "null"
      ]
    },
    "omitted": {
      "type": "string"
    },
    "phase": {
      "$ref": "#/definitions/Phase"
    },
    "thread": {
      "type": [
        "string",
        "null"
      ]
    },
    "turn": {
      "type": [
        "string",
        "null"
      ]
    },
    "version": {
      "type": "string"
    }
  },
  "required": [
    "version",
    "phase",
    "messages",
    "limited",
    "omitted"
  ],
  "title": "Snapshot",
  "type": "object"
}
