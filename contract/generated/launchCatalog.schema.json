{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "Effort": {
      "enum": [
        "low",
        "medium",
        "high",
        "xhigh",
        "max",
        "ultra"
      ],
      "type": "string"
    },
    "LaunchEntry": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "launch": {
          "$ref": "#/definitions/LaunchRecord"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "launch"
      ],
      "type": "object"
    },
    "LaunchRecord": {
      "additionalProperties": false,
      "properties": {
        "argv": {
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "effort": {
          "anyOf": [
            {
              "$ref": "#/definitions/Effort"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "type": "string"
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "permissions": {
          "anyOf": [
            {
              "$ref": "#/definitions/Permissions"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "LaunchSettings": {
      "additionalProperties": false,
      "properties": {
        "default": {
          "type": "string"
        },
        "entries": {
          "items": {
            "$ref": "#/definitions/LaunchEntry"
          },
          "type": "array"
        }
      },
      "required": [
        "default",
        "entries"
      ],
      "type": "object"
    },
    "Permissions": {
      "enum": [
        "yolo",
        "workspace-write",
        "read-only"
      ],
      "type": "string"
    }
  },
  "properties": {
    "available": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "errors": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "path": {
      "type": [
        "string",
        "null"
      ]
    },
    "settings": {
      "$ref": "#/definitions/LaunchSettings"
    }
  },
  "required": [
    "settings",
    "available",
    "errors"
  ],
  "title": "Catalog",
  "type": "object"
}
