{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "Effort": {
      "enum": [
        "low",
        "medium",
        "high",
        "xhigh",
        "max",
        "ultra"
      ],
      "type": "string"
    },
    "Launch": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "terminal",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "effort": {
              "allOf": [
                {
                  "$ref": "#/definitions/Effort"
                }
              ],
              "default": "high"
            },
            "kind": {
              "const": "codex",
              "type": "string"
            },
            "model": {
              "default": "gpt-6.1-sol",
              "type": "string"
            },
            "permissions": {
              "allOf": [
                {
                  "$ref": "#/definitions/Permissions"
                }
              ],
              "default": "yolo"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "argv": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "kind": {
              "const": "program",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "argv"
          ],
          "type": "object"
        }
      ]
    },
    "LaunchEntry": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "launch": {
          "$ref": "#/definitions/Launch"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "launch"
      ],
      "type": "object"
    },
    "LaunchSettings": {
      "additionalProperties": false,
      "properties": {
        "default": {
          "type": "string"
        },
        "entries": {
          "items": {
            "$ref": "#/definitions/LaunchEntry"
          },
          "type": "array"
        }
      },
      "required": [
        "default",
        "entries"
      ],
      "type": "object"
    },
    "Permissions": {
      "enum": [
        "yolo",
        "workspace-write",
        "read-only"
      ],
      "type": "string"
    }
  },
  "properties": {
    "available": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "errors": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "path": {
      "type": [
        "string",
        "null"
      ]
    },
    "settings": {
      "$ref": "#/definitions/LaunchSettings"
    }
  },
  "required": [
    "settings",
    "available",
    "errors"
  ],
  "title": "Catalog",
  "type": "object"
}
