{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "AgentLaunch": {
      "additionalProperties": false,
      "properties": {
        "argv": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "effort": {
          "anyOf": [
            {
              "$ref": "#/definitions/EffortSetting"
            },
            {
              "type": "null"
            }
          ]
        },
        "model": {
          "anyOf": [
            {
              "$ref": "#/definitions/ModelSetting"
            },
            {
              "type": "null"
            }
          ]
        },
        "permissions": {
          "anyOf": [
            {
              "$ref": "#/definitions/PermissionSetting"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "AgentProgram": {
      "additionalProperties": false,
      "properties": {
        "icon": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "launch": {
          "allOf": [
            {
              "$ref": "#/definitions/AgentLaunch"
            }
          ],
          "default": {
            "argv": []
          }
        },
        "name": {
          "type": "string"
        },
        "programs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "seeded": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "name",
        "programs"
      ],
      "type": "object"
    },
    "Effort": {
      "enum": [
        "low",
        "medium",
        "high",
        "xhigh",
        "max",
        "ultra"
      ],
      "type": "string"
    },
    "EffortSetting": {
      "additionalProperties": false,
      "properties": {
        "default": {
          "$ref": "#/definitions/Effort"
        },
        "flags": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "default",
        "flags"
      ],
      "type": "object"
    },
    "ModelSetting": {
      "additionalProperties": false,
      "properties": {
        "default": {
          "type": "string"
        },
        "flags": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "default",
        "flags"
      ],
      "type": "object"
    },
    "PermissionSetting": {
      "additionalProperties": false,
      "properties": {
        "default": {
          "$ref": "#/definitions/Permissions"
        },
        "readOnly": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "workspaceWrite": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "yolo": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "default",
        "yolo",
        "workspaceWrite",
        "readOnly"
      ],
      "type": "object"
    },
    "Permissions": {
      "enum": [
        "yolo",
        "workspace-write",
        "read-only"
      ],
      "type": "string"
    }
  },
  "properties": {
    "agents": {
      "items": {
        "$ref": "#/definitions/AgentProgram"
      },
      "type": "array"
    }
  },
  "required": [
    "agents"
  ],
  "title": "AgentTable",
  "type": "object"
}
