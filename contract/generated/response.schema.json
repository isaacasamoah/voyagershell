{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "Axis": {
      "enum": [
        "horizontal",
        "vertical"
      ],
      "type": "string"
    },
    "Content": {
      "additionalProperties": false,
      "properties": {
        "backend": {
          "type": [
            "string",
            "null"
          ]
        },
        "cwd": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "startPending": {
          "type": [
            "string",
            "null"
          ]
        },
        "typeId": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "typeId",
        "cwd"
      ],
      "type": "object"
    },
    "Context": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "workspace",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "const": "voyage",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "const": "fleet",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "const": "vessel",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "const": "portal",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        }
      ]
    },
    "Fleet": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "root": {
          "$ref": "#/definitions/Split"
        },
        "vessels": {
          "items": {
            "$ref": "#/definitions/Vessel"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "vessels",
        "root"
      ],
      "type": "object"
    },
    "Layout": {
      "additionalProperties": false,
      "properties": {
        "contents": {
          "items": {
            "$ref": "#/definitions/Content"
          },
          "type": "array"
        },
        "context": {
          "$ref": "#/definitions/Context"
        },
        "nextId": {
          "type": "string"
        },
        "savedLayouts": {
          "default": [],
          "items": {
            "$ref": "#/definitions/SavedLayout"
          },
          "type": "array"
        },
        "selectedFleet": {
          "type": [
            "string",
            "null"
          ]
        },
        "selectedVoyage": {
          "type": [
            "string",
            "null"
          ]
        },
        "view": {
          "allOf": [
            {
              "$ref": "#/definitions/WorkspaceView"
            }
          ],
          "default": "fleet"
        },
        "voyages": {
          "items": {
            "$ref": "#/definitions/Voyage"
          },
          "type": "array"
        }
      },
      "required": [
        "voyages",
        "contents",
        "context",
        "nextId"
      ],
      "type": "object"
    },
    "SavedLayout": {
      "additionalProperties": false,
      "properties": {
        "fleet": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "root": {
          "$ref": "#/definitions/Split"
        }
      },
      "required": [
        "fleet",
        "name",
        "root"
      ],
      "type": "object"
    },
    "Split": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "leaf",
              "type": "string"
            },
            "placement": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "placement"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "axis": {
              "$ref": "#/definitions/Axis"
            },
            "first": {
              "$ref": "#/definitions/Split"
            },
            "kind": {
              "const": "branch",
              "type": "string"
            },
            "second": {
              "$ref": "#/definitions/Split"
            }
          },
          "required": [
            "kind",
            "axis",
            "first",
            "second"
          ],
          "type": "object"
        }
      ]
    },
    "Status": {
      "enum": [
        "applied",
        "rejected",
        "uncertain"
      ],
      "type": "string"
    },
    "Vessel": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "content"
      ],
      "type": "object"
    },
    "Voyage": {
      "additionalProperties": false,
      "properties": {
        "fleets": {
          "items": {
            "$ref": "#/definitions/Fleet"
          },
          "type": "array"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "portals": {
          "items": {
            "$ref": "#/definitions/Vessel"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "fleets",
        "portals"
      ],
      "type": "object"
    },
    "WorkspaceView": {
      "enum": [
        "home",
        "fleet"
      ],
      "type": "string"
    }
  },
  "properties": {
    "createdWorkspace": {
      "type": "boolean"
    },
    "fresh": {
      "type": "boolean"
    },
    "layout": {
      "$ref": "#/definitions/Layout"
    },
    "message": {
      "type": [
        "string",
        "null"
      ]
    },
    "requestId": {
      "type": "string"
    },
    "status": {
      "$ref": "#/definitions/Status"
    },
    "version": {
      "type": "string"
    }
  },
  "required": [
    "requestId",
    "status",
    "version",
    "layout",
    "fresh",
    "createdWorkspace"
  ],
  "title": "Response",
  "type": "object"
}
