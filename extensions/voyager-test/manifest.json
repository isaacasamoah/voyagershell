{
  "manifest_version": 3,
  "name": "Voyager Test Extension",
  "version": "0.1.0",
  "description": "Interactive browser test runner for VoyagerShell",
  "permissions": ["activeTab"],
  "content_scripts": [
    {
      "matches": [
        "http://localhost:3000/*",
        "https://voyagershell.vercel.app/*"
      ],
      "js": ["dist/content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "dist/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Voyager Test Panel"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
