# Voyager environment configuration
# Copy this file to .env.local and provide only the features you use.

# Core application (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SECRET_KEY=sb_secret_...
ANTHROPIC_API_KEY=sk-ant-...

# Memory embeddings (required when memory extraction/search is enabled)
OPENAI_API_KEY=sk-...

# Optional query reformulation; retrieval falls back cleanly when omitted.
GOOGLE_GEMINI_API_KEY=AIza...

# Application URL (optional locally; VERCEL_URL is used when deployed)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Feature-specific
# Required only for encrypted per-user model connections.
ENCRYPTION_KEY=
# Required only for magic-link and invitation email delivery.
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL="Voyager <hello@example.com>"
# Optional retrieval providers; their features degrade when omitted.
TAVILY_API_KEY=tvly-...
COHERE_API_KEY=...

# Optional diagnostics
VOYAGER_DEBUG=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Vercel supplies this automatically in hosted deployments.
# VERCEL_URL=your-app.vercel.app
