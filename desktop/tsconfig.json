{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "strict": true,
    "noEmitOnError": true,
    "removeComments": true,
    "useDefineForClassFields": false,
    "rootDir": "..",
    "outDir": "../target/script-types/emitted",
    "rootDirs": [
      "canvas",
      "../content",
      "../contract/generated"
    ],
    "types": []
  },
  "files": [
    "canvas/main.ts",
    "canvas/regions.ts",
    "canvas/creation.ts",
    "../contract/generated/workspace.ts",
    "../contract/generated/conversation.ts",
    "canvas/chat.ts",
    "../target/script-types/gpui-kit.d.ts"
  ]
}
