+/// What a host lets one [`ShellRuntime`](super::ShellRuntime) spend.
+///
+/// The default is the shell's own policy: no heap ceiling, the watchdog
+/// budgets above, no share and no strike limit. A host that embeds engines it
+/// does not trust, several to a window, tightens them before the first load.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct EngineLimits {
+    heap_bytes: Option<usize>,
+    budgets: Budgets,
+    share_per_second: Option<Duration>,
+    strike_limit: Option<u32>,
+}
+
+impl EngineLimits {
+    pub fn new() -> Self {
+        Self::default()
+    }
+
+    /// The JavaScript heap ceiling. An allocation past it is refused with the
+    /// out-of-memory report rather than aborting the process.
+    pub fn with_heap_bytes(mut self, bytes: usize) -> Self {
+        self.heap_bytes = Some(bytes);
+        self
+    }
+
+    pub fn heap_bytes(&self) -> Option<usize> {
+        self.heap_bytes
+    }
+
+    /// How long one render or layout call may run before it is stopped.
+    pub fn with_render_budget(mut self, budget: Duration) -> Self {
+        self.budgets.render = budget;
+        self
+    }
+
+    pub fn render_budget(&self) -> Duration {
+        self.budgets.render
+    }
+
+    /// How long one event handler or resumed task may run before it is stopped.
+    pub fn with_event_budget(mut self, budget: Duration) -> Self {
+        self.budgets.event = budget;
+        self
+    }
+
+    pub fn event_budget(&self) -> Duration {
+        self.budgets.event
+    }
+
+    /// How long one module evaluation may run before it is stopped.
+    pub fn with_load_budget(mut self, budget: Duration) -> Self {
+        self.budgets.detached = budget;
+        self
+    }
+
+    pub fn load_budget(&self) -> Duration {
+        self.budgets.detached
+    }
