+        (self.rolled_busy(now) + current > share).then_some(share)
+    }
+
+    fn strike(&self, refusal: Refusal) {
+        let strikes = self.strikes.get().saturating_add(1);
+        self.strikes.set(strikes);
+        if self.retirement.get().is_none()
+            && self
+                .limits
+                .get()
+                .strike_limit
+                .is_some_and(|limit| strikes >= limit)
+        {
+            self.retirement.set(Some(Retirement {
+                strikes,
+                last: refusal,
+            }));
+        }
+    }
