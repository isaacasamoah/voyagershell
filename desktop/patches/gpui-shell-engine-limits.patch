+pub(super) fn metered_interrupt_handler(
+    meter: std::rc::Rc<Meter>,
+) -> impl FnMut() -> bool + 'static {
+    let mut call_deadline = deadline(meter.limits().budgets);
+    move || {
+        if call_deadline() {
+            refuse(Refusal::Budget);
+            return true;
+        }
+        let Some(share) = meter.overspent(Instant::now()) else {
+            return false;
+        };
+        let phase = scope::current_phase();
+        INTERRUPTION.with(|interruption| {
+            interruption.set(Some(Interruption {
+                phase,
+                budget: share,
+                refusal: Refusal::Share,
+            }))
+        });
+        refuse(Refusal::Share);
+        true
+    }
