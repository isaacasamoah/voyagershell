+    fn rolled_busy(&self, now: Instant) -> Duration {
+        if now.duration_since(self.second_started.get()) >= Duration::from_secs(1) {
+            self.second_started.set(now);
+            self.busy.set(Duration::ZERO);
+        }
+        self.busy.get()
+    }
