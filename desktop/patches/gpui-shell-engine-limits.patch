+impl Refusal {
+    fn reason(self) -> &'static str {
+        match self {
+            Self::Budget => "a call ran past its time budget",
+            Self::Share => "its calls used more than their share of the window's time",
+            Self::OutOfMemory => "its JavaScript heap reached its limit",
