+pub(super) struct Metered<'a> {
+    meter: &'a Meter,
+    outer: Option<Option<Refusal>>,
+}
+
+impl Drop for Metered<'_> {
+    fn drop(&mut self) {
+        let Some(outer) = self.outer else {
+            return;
+        };
+        let now = Instant::now();
+        if let Some(started) = self.meter.entered.take() {
+            let busy = self.meter.rolled_busy(now) + now.saturating_duration_since(started);
+            self.meter.busy.set(busy);
+        }
+        if let Some(refusal) = REFUSED.with(|refused| refused.replace(outer)) {
+            self.meter.strike(refusal);
+        }
+    }
+}
