+    /// How much of each second the engine's calls may hold the UI thread
+    /// together. A call that takes the total past it is stopped, so many short
+    /// calls cannot hold the window where one long call could not.
+    pub fn with_share_per_second(mut self, share: Duration) -> Self {
+        self.share_per_second = Some(share);
