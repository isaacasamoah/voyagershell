+    /// Applies new limits and forgives earlier strikes and a retirement.
+    pub(super) fn reset(&self, limits: EngineLimits) {
+        self.limits.set(limits);
+        self.strikes.set(0);
+        self.retirement.set(None);
+        self.busy.set(Duration::ZERO);
+        self.second_started.set(Instant::now());
+    }
+
+    pub(super) fn strikes(&self) -> u32 {
+        self.strikes.get()
+    }
+
+    pub(super) fn retirement(&self) -> Option<Retirement> {
+        self.retirement.get()
+    }
+
+    /// Times one entry into the engine. A nested entry is part of the outer
+    /// one, so only the outermost is timed and counted.
+    pub(super) fn enter(&self) -> Metered<'_> {
+        if self.entered.get().is_some() {
+            return Metered {
+                meter: self,
+                outer: None,
+            };
+        }
+        self.entered.set(Some(Instant::now()));
+        Metered {
+            meter: self,
+            outer: Some(REFUSED.with(Cell::take)),
+        }
+    }
