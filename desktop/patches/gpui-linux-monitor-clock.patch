+
+struct RefreshMode {
+    bounds: [i32; 4],
+    interval: Duration,
+}
+
+fn select_refresh_interval(
+    bounds: [i32; 4],
+    modes: &[RefreshMode],
+    previous: Duration,
+) -> Duration {
+    modes
+        .iter()
+        .filter_map(|mode| {
+            let [x, y, width, height] = bounds.map(i64::from);
+            let [mx, my, mw, mh] = mode.bounds.map(i64::from);
+            let overlap = ((x + width).min(mx + mw) - x.max(mx)).max(0)
+                * ((y + height).min(my + mh) - y.max(my)).max(0);
+            (overlap > 0 && !mode.interval.is_zero()).then_some((
+                overlap,
+                mode.interval == previous,
+                mode.interval,
+            ))
+        })
+        .max_by_key(|(area, retained, _)| (*area, *retained))
+        .map_or(previous, |(_, _, interval)| interval)
+}
+
+fn query_refresh_modes(connection: &XCBConnection) -> HashMap<xproto::Window, Vec<RefreshMode>> {
+    connection
+        .setup()
+        .roots
+        .iter()
+        .filter_map(|screen| {
+            let resources = get_reply(
+                || "Failed to read display modes",
+                connection.randr_get_screen_resources_current(screen.root),
+            )
+            .log_err()?;
+            let modes = resources
+                .crtcs
+                .iter()
+                .filter_map(|crtc| {
+                    let crtc = connection
+                        .randr_get_crtc_info(*crtc, x11rb::CURRENT_TIME)
+                        .ok()?
+                        .reply()
+                        .ok()?;
+                    if crtc.width == 0 || crtc.height == 0 {
+                        return None;
+                    }
+                    let mode = resources.modes.iter().find(|mode| mode.id == crtc.mode)?;
+                    let interval = mode_refresh_rate(mode);
+                    (!interval.is_zero()).then_some(RefreshMode {
+                        bounds: [
+                            i32::from(crtc.x),
+                            i32::from(crtc.y),
+                            i32::from(crtc.width),
+                            i32::from(crtc.height),
+                        ],
+                        interval,
+                    })
+                })
+                .collect();
+            Some((screen.root, modes))
+        })
+        .collect()
 }

