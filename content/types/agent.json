{
  "contract": 1,
  "id": "agent",
  "name": "Agent",
  "version": 1,
  "state": {
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["screen", "title"],
      "properties": {
        "screen": { "type": "string" },
        "title": { "type": "string" }
      }
    },
    "initial": { "screen": "", "title": "" }
  },
  "actions": {},
  "view": { "source": "native/terminal" },
  "backend": { "kind": "core-terminal" },
  "orbit": [
    {
      "id": "ask-work",
      "label": "Ask what this agent is working on",
      "short": "Ask",
      "icon": "message",
      "group": "ask",
      "run": { "agent": "summarise-agent", "read": "title" }
    },
    {
      "id": "ask-screen",
      "label": "Ask about this agent's screen",
      "icon": "message",
      "group": "ask",
      "run": { "agent": "explain-terminal", "read": "screen" }
    }
  ],
  "dock": [
    {
      "id": "screen",
      "label": "Read the screen while docked",
      "trigger": "while-docked",
      "default": "off",
      "read": "screen"
    }
  ]
}
