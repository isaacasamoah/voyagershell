{
  "name": "voyagershell-native-build",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "contract:generate": "node contract/build.cjs --write",
    "contract:check": "node contract/build.cjs --check",
    "core-schema:generate": "node app/core-schema.cjs --write",
    "core-schema:check": "node app/core-schema.cjs --check",
    "test": "npm run typecheck && node --test contract/validator-test.cjs desktop/terminal-test.cjs desktop/rename-test.cjs desktop/typecheck-test.cjs desktop/notes-test.cjs desktop/canvas-test.cjs tools/architecture/gate-test.cjs",
    "format:check": "prettier --check contract/build.cjs 'tools/architecture/*.cjs' app/core-schema.cjs 'desktop/*.{cjs,json}' 'desktop/mods/**/*.{ts,js,json}' 'desktop/themes/*.json' 'content/**/*.{ts,js,json}'",
    "typecheck": "node desktop/typecheck.cjs --check",
    "scripts:generate": "node desktop/typecheck.cjs --write",
    "architecture:check": "node tools/architecture/gate.cjs"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "json-schema-to-typescript": "16.0.0",
    "prettier": "3.9.9",
    "typescript": "5.9.3"
  }
}
