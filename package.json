{
  "name": "voyagershell-native-build",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "contract:generate": "node contract/build.cjs --write",
    "contract:check": "node contract/build.cjs --check",
    "core-schema:generate": "node app/core-schema.cjs --write",
    "core-schema:check": "node app/core-schema.cjs --check",
    "test": "npm run typecheck && node --test contract/validator-test.cjs desktop/terminal-test.cjs desktop/rename-test.cjs desktop/typecheck-test.cjs desktop/canvas-test.cjs tests/architecture/gate-test.cjs tests/architecture/families-test.cjs tests/architecture/owners-test.cjs tests/architecture/vocabulary-test.cjs tests/architecture/observe-test.cjs tests/architecture/delta-test.cjs tests/architecture/features-test.cjs scripts/comments-check-test.cjs scripts/prose-check-test.cjs scripts/ci-steps-local-test.cjs scripts/release-data-test.cjs scripts/release-test.cjs",
    "format:check": "prettier --check contract/build.cjs 'tests/architecture/*.cjs' app/core-schema.cjs 'desktop/*.{cjs,json}' 'desktop/canvas/**/*.{ts,js,json}' 'desktop/themes/*.json' 'content/**/*.{ts,js,json}' 'scripts/*.cjs'",
    "typecheck": "node desktop/typecheck.cjs --check",
    "scripts:generate": "node desktop/typecheck.cjs --write",
    "architecture:check": "node tests/architecture/gate.cjs",
    "architecture:delta": "node tests/architecture/delta.cjs",
    "architecture:intended": "node tests/architecture/gate.cjs --write-intended",
    "ci:local": "node scripts/ci-steps-local.cjs",
    "comments:check": "node scripts/comments-check.cjs",
    "prose:check": "node scripts/prose-check.cjs",
    "features:check": "node tests/architecture/features.cjs",
    "features:generate": "node tests/architecture/features.cjs --write",
    "vocabulary:check": "node tests/architecture/vocabulary.cjs",
    "vocabulary:generate": "node tests/architecture/vocabulary.cjs --generate"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "json-schema-to-typescript": "16.0.0",
    "prettier": "3.9.9",
    "typescript": "5.9.3"
  }
}
