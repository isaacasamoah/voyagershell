     pub fn apply(&mut self, action: Action) -> Result<(), String> {
+        let twin = matches!(action, Action::CreateVoyage { .. }).then(|| action.clone());
         self.change(action)?;
+        if let Some(twin) = twin {
+            let voyage = self.layout.selected_voyage.clone();
+            let fleet = self.layout.selected_fleet.clone();
+            self.change(twin)?;
+            self.layout.selected_voyage = voyage;
+            self.layout.selected_fleet = fleet;
+        }
         self.remember_fleet();
         Ok(())
     }
